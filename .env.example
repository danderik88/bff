# Copy to .env, then fill the CHANGE_ME values (the README shows one command that does it).

# This machine's address on your network (or its Tailscale IP). Phones and agents connect here.
PYGMY_MCP_BIND=CHANGE_ME_IP
PYGMY_MCP_PORT=8765

# name=token, token at least 32 characters. The token opens the app: http://IP:8765/app#k=TOKEN
PYGMY_MCP_TOKENS=me=CHANGE_ME_TOKEN

# 1 = commands allowed (print, pause, stop, light, temperatures). 0 = watch only.
PYGMY_MCP_CONTROL=1

# Print now: the slicer container from docker-compose.yml.
PYGMY_SLICER_URL=http://127.0.0.1:8770
PYGMY_SLICER_SECRET=CHANGE_ME_SLICER

# Camera re-stream for Home Assistant (go2rtc, rtsp://IP:8554/<printer>).
PYGMY_RTSP_USER=pygmy
PYGMY_RTSP_PASS=CHANGE_ME_RTSP
# Secret in the camera stream links, 16+ characters
# PYGMY_STREAM_TOKEN=

# PYGMY_EXPERT_MODELS=O1D   # unlock Expert mode on an untested model (you map its safe area; stay next to the printer)

# Spaghetti detection: the ml_api container from docker-compose.yml (x86_64; off on ARM).
PYGMY_OBICO_URL=http://127.0.0.1:3333
